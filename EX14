#include <stdio.h>
#include <string.h>

int main() {
    char files[50][50];
    int n = 0, choice;
    char name[50];

    while(1) {
        printf("\n1.Create 2.Display 3.Search 4.Exit\n");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                printf("Enter file name: ");
                scanf("%s", files[n++]);
                break;

            case 2:
                for(int i=0;i<n;i++)
                    printf("%s\n", files[i]);
                break;

            case 3:
                printf("Enter file name: ");
                scanf("%s", name);
                for(int i=0;i<n;i++)
                    if(strcmp(name, files[i])==0)
                        printf("File found\n");
                break;

            case 4:
                return 0;
        }
    }
}
