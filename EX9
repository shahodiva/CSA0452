#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <string.h>
#include <unistd.h>

int main() {
    int shmid;
    char *str;

    shmid = shmget(1234, 1024, 0666 | IPC_CREAT);
    str = (char*) shmat(shmid, NULL, 0);

    if (fork() == 0) {
        // Child writes
        strcpy(str, "Hello from Child Process");
        printf("Child wrote: %s\n", str);
    } else {
        sleep(1);
        printf("Parent reads: %s\n", str);
    }

    shmdt(str);
    shmctl(shmid, IPC_RMID, NULL);

    return 0;
}
