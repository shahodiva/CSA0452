#include <stdio.h>

struct Process {
    int id, bt, wt, tat;
};

int main() {
    int n;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    for(int i = 0; i < n; i++) {
        p[i].id = i+1;
        printf("Enter BT for P%d: ", i+1);
        scanf("%d", &p[i].bt);
    }

    // Sort
    for(int i = 0; i < n; i++) {
        for(int j = i+1; j < n; j++) {
            if(p[i].bt > p[j].bt) {
                struct Process temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    p[0].wt = 0;

    for(int i = 1; i < n; i++) {
        p[i].wt = p[i-1].wt + p[i-1].bt;
    }

    for(int i = 0; i < n; i++) {
        p[i].tat = p[i].wt + p[i].bt;
    }

    printf("\nP\tBT\tWT\tTAT\n");
    for(int i = 0; i < n; i++) {
        printf("%d\t%d\t%d\t%d\n", p[i].id, p[i].bt, p[i].wt, p[i].tat);
    }

    return 0;
}
